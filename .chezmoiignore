# Files chezmoi should not manage.
#
# Two categories: output generated by the theme switcher (~/.config/theme), and
# state that is machine-local by nature. Generated files are recreated by the
# run_onchange_after_apply-theme.sh script on every `chezmoi apply`, so a fresh
# machine still ends up with a complete, working config.

# -- theme switcher output (see bootstrap/render.go) -------------------------
.config/kitty/theme.conf
.config/alacritty/colors.toml
.config/nvim/lua/theme.lua
.config/doom/theme.el
.config/hypr/colors.conf
.config/hypr/hyprpaper.conf
.config/quickshell/generated/
.config/btop/themes/
.config/Kvantum/

# -- machine-local state -----------------------------------------------------
# fish universal variables
.config/fish/fish_variables
# active theme name; managing it would flip the theme on every apply
.config/theme/current
.config/theme/__pycache__/
# symlinks into the generated ~/.themes/ tree, recreated by renderGTK
.config/gtk-4.0/gtk.css
.config/gtk-4.0/gtk-dark.css
# symlink to the separate wallpapers repo
.config/hypr/wallpapers
# stale pre-Lua Hyprland config, kept on disk for reference only
.config/hypr/_backup-2026-06-09/

# The repo README is documentation, not a dotfile.
README.md

# The setup TUI is source code that ships with the repo, not a dotfile.
bootstrap
