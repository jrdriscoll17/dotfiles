# Machine-local state and generated output. These live at the stow target as
# real files/dirs (not symlinks into this repo), so each host keeps its own.

# fish universal variables — fish rewrites this via atomic rename, which would
# replace the symlink with a real file and silently orphan the repo copy.
fish/.config/fish/fish_variables

# Quickshell palette output: ~2.6M, regenerated by `theme apply`.
quickshell/.config/quickshell/generated/

# theme switcher bytecode
theme/.config/theme/__pycache__/

# GTK4 css are symlinks into ~/.themes/<generated theme>; theme.py recreates
# them on every apply (see theme.py render_gtk).
gtk/.config/gtk-4.0/gtk.css
gtk/.config/gtk-4.0/gtk-dark.css

# Wallpapers live in their own repo, symlinked in as ~/.config/hypr/wallpapers.
hypr/.config/hypr/wallpapers

# Pre-Lua Hyprland config, kept on disk for reference only.
hypr/.config/hypr/_backup-2026-06-09/
