{{- $laptop := promptBoolOnce . "laptop" "Is this a laptop (battery, backlight, no fixed monitor layout)" -}}
# Generated by `chezmoi init` from .chezmoi.toml.tmpl. Edit the template, not
# this file — a re-init overwrites it.

# The source repo lives at ~/dotfiles rather than chezmoi's default
# ~/.local/share/chezmoi, so it has to be stated explicitly.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    hostname = {{ .chezmoi.hostname | quote }}
    # Drives the per-host branches in templates (e.g. the monitor block in
    # dot_config/hypr/hyprland.lua.tmpl). Asked once on first init and then
    # remembered; change it with `chezmoi init --data=false` or by editing this
    # file.
    laptop = {{ $laptop }}
